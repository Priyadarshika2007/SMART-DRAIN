# ============================================
# UrbanDrainX V2 - Environment Configuration Template
# Copy this file to .env and populate with your local/deployment credentials.
# ============================================

# Database Configuration (MongoDB)
# Format: mongodb://<host>:<port>/<database> or mongodb+srv://<user>:<password>@<cluster>/<database>
MONGODB_URI=mongodb://127.0.0.1:27017/urbandrainx

# Node Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL (for Backend CORS allowlist)
FRONTEND_URL=http://localhost:5001

# React Frontend API Base URL
REACT_APP_API_URL=http://localhost:5000/api

# Alert Email Notifications (Optional - SMTP / Gmail App Password)
EMAIL_USER=priyadarshika1129@gmail.com
EMAIL_PASS=your_email_app_password
ALERT_EMAIL=alerts@example.com
